<%- include('partials/head', { title: 'Dashboard' }) %>
<%- include('partials/sidebar', { page: 'dashboard', admin: admin }) %>






<style>
  :root {
    --navy-900: #101B38;
    --navy-800: #1B2A52;
    --paper: #FAF7EF;
    --surface: #FFFFFF;
    --line: #E4DFD2;
    --gold: #C79A3E;
    --green: #2C7A5B;
    --ink: #22201B;
    --ink-muted: #6B6558;
    --radius: 8px;
  }

  .mono { font-family: 'IBM Plex Mono', monospace; }
  .serif { font-family: 'Newsreader', 'Source Serif 4', serif; }

  .vs-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 32px 80px;
  }

  /* ---------------- PROMINENT BRAND HERO ---------------- */
  .vs-hero {
    margin-bottom: 56px;
    padding-bottom: 36px;
    border-bottom: 1px solid var(--line);
  }

  .vs-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--green);
    font-weight: 600;
    margin-bottom: 12px;
  }

  .vs-badge::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
  }

  /* HUGE BRAND HEADING */
  h1.vs-brand-title {
    font-family: 'Newsreader', 'Source Serif 4', serif;
    font-size: clamp(48px, 7vw, 84px);
    font-weight: 600;
    color: var(--navy-900);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  /* SUBTITLE HEADING */
  .vs-tagline {
    font-family: 'Newsreader', 'Source Serif 4', serif;
    font-size: clamp(22px, 3.2vw, 36px);
    font-weight: 400;
    color: var(--gold);
    font-style: italic;
    margin-bottom: 24px;
  }

  p.vs-lead-text {
    font-size: 20px;
    color: var(--ink-muted);
    max-width: 820px;
    line-height: 1.6;
  }

  /* ---------------- METRICS STRIP ---------------- */
  .vs-metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-bottom: 64px;
  }

  .vs-metric-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px 20px;
  }

  .vs-metric-card .num {
    font-family: 'Newsreader', 'Source Serif 4', serif;
    font-size: 38px;
    font-weight: 500;
    color: var(--navy-800);
    line-height: 1;
    margin-bottom: 8px;
  }

  .vs-metric-card .lbl {
    font-size: 13.5px;
    color: var(--ink-muted);
  }

  /* ---------------- CORE PILLARS ---------------- */
  .vs-section-title {
    font-family: 'Newsreader', 'Source Serif 4', serif;
    font-size: 32px;
    font-weight: 500;
    color: var(--navy-900);
    margin-bottom: 32px;
  }

  .vs-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-bottom: 64px;
  }

  .vs-feature-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 36px 28px;
  }

  .vs-feature-card .icon {
    font-size: 28px;
    margin-bottom: 16px;
    display: inline-block;
  }

  .vs-feature-card h3 {
    font-family: 'Newsreader', 'Source Serif 4', serif;
    font-size: 22px;
    font-weight: 600;
    color: var(--navy-900);
    margin-bottom: 12px;
  }

  .vs-feature-card p {
    font-size: 15px;
    color: var(--ink-muted);
    line-height: 1.6;
  }

  /* ---------------- WORKFLOW BOX ---------------- */
  .vs-workflow-panel {
    background: var(--navy-900);
    color: var(--paper);
    border-radius: var(--radius);
    padding: 56px 48px;
    margin-bottom: 40px;
  }

  .vs-workflow-panel h2 {
    font-family: 'Newsreader', 'Source Serif 4', serif;
    font-size: 36px;
    color: var(--paper);
    margin-bottom: 36px;
  }

  .vs-steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 36px;
  }

  .vs-step-col {
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    padding-top: 24px;
  }

  .vs-step-col .step-code {
    font-family: 'IBM Plex Mono', monospace;
    color: var(--gold);
    font-size: 13.5px;
    margin-bottom: 10px;
  }

  .vs-step-col h4 {
    font-size: 19px;
    font-weight: 500;
    color: #FFFFFF;
    margin-bottom: 10px;
  }

  .vs-step-col p {
    font-size: 14px;
    color: #A0A7B8;
    line-height: 1.6;
  }

  @media(max-width: 900px) {
    .vs-metrics { grid-template-columns: repeat(2, 1fr); }
    .vs-grid-3, .vs-steps-grid { grid-template-columns: 1fr; }
    .vs-workflow-panel { padding: 36px 24px; }
  }
</style>

<main class="vs-container">

  <!-- HERO SECTION WITH HUGE BRAND NAME -->
  <section class="vs-hero">
    <div class="vs-badge">Project Visibility Portal</div>
    
    <!-- BIG MAIN HEADING -->
    <h1 class="vs-brand-title">VidyaSetu</h1>
    
    <!-- SUBTITLE -->
    <div class="vs-tagline">Scholarship visibility, all in one place.</div>

    <p class="vs-lead-text">
      <%= typeof projectDescription !== 'undefined' ? projectDescription : "VidyaSetu is a single-view portal designed to provide instant visibility into student eligibility, uploaded documents, and application statuses across Maharashtra colleges—without complex management or data modification." %>
    </p>
  </section>

  <!-- METRICS STRIP -->
  <section class="vs-metrics">
    <div class="vs-metric-card">
      <div class="num mono"><%= typeof stats !== 'undefined' && stats.colleges ? stats.colleges : '340+' %></div>
      <div class="lbl">Partner Colleges Covered</div>
    </div>
    <div class="vs-metric-card">
      <div class="num mono"><%= typeof stats !== 'undefined' && stats.students ? stats.students : '18,400+' %></div>
      <div class="lbl">Students on Record</div>
    </div>
    <div class="vs-metric-card">
      <div class="num mono"><%= typeof stats !== 'undefined' && stats.auditRate ? stats.auditRate : '92%' %></div>
      <div class="lbl">Documents Uploaded on File</div>
    </div>
    <div class="vs-metric-card">
      <div class="num mono"><%= typeof stats !== 'undefined' && stats.avgTime ? stats.avgTime : '< 3 Days' %></div>
      <div class="lbl">Avg. Verification Backlog</div>
    </div>
  </section>

  <!-- KEY PILLARS -->
  <section>
    <h2 class="vs-section-title">Core Pillars & Purpose</h2>

    <div class="vs-grid-3">
      <div class="vs-feature-card">
        <span class="icon">👁️</span>
        <h3>Read-Only View</h3>
        <p>Serves purely as a read-only dashboard. Registrars and administrators can view where things stand without options to upload, edit, or delete source records.</p>
      </div>

      <div class="vs-feature-card">
        <span class="icon">📄</span>
        <h3>Zero Re-uploads</h3>
        <p>Check uploaded student certificates directly on file. Immediately identify what is verified and what remains missing without asking for re-submissions.</p>
      </div>

      <div class="vs-feature-card">
        <span class="icon">🎯</span>
        <h3>Eligibility Matching</h3>
        <p>Automated evaluation maps student details against criteria for Merit Grants, SC/ST Fee Reimbursements, First Generation Grants, and more.</p>
      </div>
    </div>
  </section>

  <!-- SYSTEM WORKFLOW -->
  <section class="vs-workflow-panel">
    <h2>How VidyaSetu Operates</h2>

    <div class="vs-steps-grid">
      <div class="vs-step-col">
        <div class="step-code">STEP 01</div>
        <h4>Source Data Sync</h4>
        <p>Pulls live information straight from student records and institute submissions without duplicating databases.</p>
      </div>

      <div class="vs-step-col">
        <div class="step-code">STEP 02</div>
        <h4>Instant Verification</h4>
        <p>Enables administrative desks to clear verification backlogs in under three days instead of losing weeks to paperwork.</p>
      </div>

      <div class="vs-step-col">
        <div class="step-code">STEP 03</div>
        <h4>Status Tracking</h4>
        <p>Provides complete visibility into active, approved, and pending application statuses across all partner colleges.</p>
      </div>
    </div>
  </section>

</main>

<%- include('partials/footer') %>