<%- include('partials/head', { title: 'Scholarship Management' }) %>
<%- include('partials/sidebar', { page: 'scholarships', admin: admin }) %>

<div class="topbar">
  <div class="heading"><div class="eyebrow">Scholarship Management</div><h1>Scholarships</h1></div>
</div>

<div class="kpi-row c2">
  <div class="kpi">
    <div class="top-row"><span class="label">Total Scholarships</span><div class="icon icon-gold"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 15l-5.5 3 1.5-6L3 8l6-.5L12 2l3 5.5 6 .5-5 4 1.5 6z"/></svg></div></div>
    <div class="value serif"><%= kpis.total %></div>
    <div class="delta up"><%= kpis.openCount %> currently open</div>
  </div>
  <div class="kpi">
    <div class="top-row"><span class="label">Total Seats</span><div class="icon icon-blue"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div></div>
    <div class="value serif"><%= kpis.totalSeats.toLocaleString('en-IN') %></div>
    <div class="delta warn">Avg ₹<%= kpis.avgAmount.toLocaleString('en-IN') %> / student</div>
  </div>
</div>

<form class="filter-bar" method="GET" action="/scholarships">
  <div class="search-wrap">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
    <input type="text" name="search" placeholder="Search scholarships…" value="<%= filters.search %>" style="border:none;outline:none;background:transparent;font:inherit;width:100%;" />
  </div>
  <div class="filter-divider"></div>

  <select name="category" class="fselect" onchange="this.form.submit()">
    <option value="">Category</option>
    <% ['General','OBC','SC','ST','EWS','All'].forEach(function(c) { %>
    <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
    <% }) %>
  </select>

  <select name="status" class="fselect" onchange="this.form.submit()">
    <option value="">Status</option>
    <option value="Open" <%= filters.status === 'Open' ? 'selected' : '' %>>Open</option>
    <option value="Closed" <%= filters.status === 'Closed' ? 'selected' : '' %>>Closed</option>
  </select>

  <select name="sort" class="fselect" onchange="this.form.submit()">
    <option value="asc" <%= filters.sort === 'ASC' ? 'selected' : '' %>>Deadline: Nearest</option>
    <option value="desc" <%= filters.sort === 'DESC' ? 'selected' : '' %>>Deadline: Farthest</option>
  </select>

  <button type="submit" class="fselect" style="cursor:pointer;">Apply</button>
  <div class="results-count"><%= pagination.totalCount %> scholarships found</div>
</form>

<div class="grid-2 wide-right">
  <div class="panel">
    <table>
      <thead><tr><th>Scholarship</th><th>Category</th><th>Amount</th><th>Seats</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% scholarships.forEach(function(s) { %>
        <tr
          class="<%= selectedScholarship && s.id === selectedScholarship.id ? 'selected' : '' %>"
          style="cursor:pointer;"
          onclick="window.location='/scholarships?selected=<%= s.id %>&search=<%= encodeURIComponent(filters.search) %>&category=<%= encodeURIComponent(filters.category) %>&status=<%= encodeURIComponent(filters.status) %>&sort=<%= filters.sort === 'DESC' ? 'desc' : 'asc' %>&page=<%= pagination.currentPage %>'"
        >
          <td><div class="stu"><div class="mini-avatar gold"><%= s.initials %></div><div><div class="n"><%= s.name %></div><div class="m">Deadline: <%= s.deadline %></div></div></div></td>
          <td><%= s.category %></td>
          <td class="amount">₹<%= s.amountPerStudent.toLocaleString('en-IN') %></td>
          <td><%= s.seatsTotal.toLocaleString('en-IN') %></td>
          <td><span class="pill <%= s.statusClass %>"><%= s.statusLabel %></span></td>
          <td><div class="row-icon">⋯</div></td>
        </tr>
        <% }) %>
        <% if (scholarships.length === 0) { %>
        <tr><td colspan="6" style="text-align:center;padding:24px;color:var(--muted,#888);">No scholarships match your filters.</td></tr>
        <% } %>
      </tbody>
    </table>
    <div class="pagination">
      <div class="info">Showing <%= pagination.from %>–<%= pagination.to %> of <%= pagination.totalCount %></div>
      <div class="page-btns">
        <a class="page-btn" href="/scholarships?page=<%= Math.max(pagination.currentPage - 1, 1) %>&search=<%= encodeURIComponent(filters.search) %>&category=<%= encodeURIComponent(filters.category) %>&status=<%= encodeURIComponent(filters.status) %>&sort=<%= filters.sort === 'DESC' ? 'desc' : 'asc' %>">‹</a>
        <% for (let p = 1; p <= pagination.totalPages; p++) { %>
        <a class="page-btn <%= p === pagination.currentPage ? 'active' : '' %>" href="/scholarships?page=<%= p %>&search=<%= encodeURIComponent(filters.search) %>&category=<%= encodeURIComponent(filters.category) %>&status=<%= encodeURIComponent(filters.status) %>&sort=<%= filters.sort === 'DESC' ? 'desc' : 'asc' %>"><%= p %></a>
        <% } %>
        <a class="page-btn" href="/scholarships?page=<%= Math.min(pagination.currentPage + 1, pagination.totalPages) %>&search=<%= encodeURIComponent(filters.search) %>&category=<%= encodeURIComponent(filters.category) %>&status=<%= encodeURIComponent(filters.status) %>&sort=<%= filters.sort === 'DESC' ? 'desc' : 'asc' %>">›</a>
      </div>
    </div>
  </div>

  <div class="panel">
    <% if (selectedScholarship) { %>
    <div class="detail-top">
      <div class="detail-status"><span class="pill <%= selectedScholarship.statusClass %>"><%= selectedScholarship.statusLabel %></span></div>
      <div class="detail-avatar" style="background:var(--gold-500);"><%= selectedScholarship.initials %></div>
      <div class="detail-name"><%= selectedScholarship.name %></div>
      <div class="detail-id"><%= selectedScholarship.code %> &nbsp;·&nbsp; <%= selectedScholarship.category %> Category</div>
    </div>
    <div class="detail-body">
      <div class="info-grid">
        <div class="info-item"><div class="k">Amount / Student</div><div class="v">₹<%= selectedScholarship.amountPerStudent.toLocaleString('en-IN') %></div></div>
        <div class="info-item"><div class="k">Min. CGPA</div><div class="v"><%= selectedScholarship.minCgpa ?? '—' %></div></div>
        <div class="info-item"><div class="k">Provider</div><div class="v"><%= selectedScholarship.provider %></div></div>
        <div class="info-item"><div class="k">Deadline</div><div class="v"><%= selectedScholarship.deadline %></div></div>
      </div>
      <div class="subhead">Total Seats</div>
      <div class="stat-row">
        <div class="stat-box"><div class="num serif"><%= selectedScholarship.seatsTotal.toLocaleString('en-IN') %></div><div class="lbl">Seats</div></div>
        <div class="stat-box"><div class="num serif">₹<%= (selectedScholarship.incomeCeiling ?? 0).toLocaleString('en-IN') %></div><div class="lbl">Income Ceiling</div></div>
      </div>
    </div>
    <% } else { %>
    <div class="detail-body"><p style="padding:24px;color:var(--muted,#888);">Select a scholarship from the list to see details.</p></div>
    <% } %>
  </div>
</div>

</main>
<%- include('partials/footer') %>
