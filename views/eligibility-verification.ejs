<%- include('partials/head', { title: 'Eligibility & Verification' }) %>
<%- include('partials/sidebar', { page: 'eligibility', admin: admin }) %>

<style>
  tr.verif-row { cursor: pointer; }
  #verif-panel.loading { opacity: 0.5; pointer-events: none; transition: opacity 0.15s ease; }
  .tabx { cursor: pointer; }

  .fselect {
    position: relative;
    cursor: pointer;
    user-select: none;
  }
  .fselect.active { border-color: #6366f1; color: #6366f1; }
  .fselect-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 180px;
    max-height: 260px;
    overflow-y: auto;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    z-index: 50;
    padding: 4px;
  }
  .fselect.open .fselect-dropdown { display: block; }
  .fselect-option { padding: 8px 10px; border-radius: 6px; font-size: 13px; color: #374151; white-space: nowrap; }
  .fselect-option:hover { background: #f3f4f6; }
  .fselect-option.selected { background: #eef2ff; color: #4338ca; font-weight: 500; }

  .page-btn { cursor: pointer; }
  .page-btn.disabled { opacity: 0.4; pointer-events: none; }

  button.danger, button.primary, #export-btn { cursor: pointer; }
  button:disabled { opacity: 0.5; cursor: not-allowed; }

  .pill.missing { background: #f3f4f6; color: #6b7280; }
  .check-icon.missing { color: #9ca3af; }
</style>

<div class="topbar">
  <div class="heading"><div class="eyebrow">Eligibility &amp; Verification</div><h1>Document Verification</h1></div>
  <button class="btn-outline" id="export-btn"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>Export</button>
</div>

<div class="tabs-row" id="tabs-row">
  <% tabs.forEach(function(t) { %>
  <div class="tabx <%= t.key === activeTab ? 'active' : '' %>" data-tab="<%= t.key %>"><%= t.label %></div>
  <% }) %>
</div>



<div class="filter-bar">
  <div class="search-wrap"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
    <input type="text" id="search-input" placeholder="Search students…" style="border:none;outline:none;background:transparent;font:inherit;width:100%;">
  </div>
  <div class="filter-divider"></div>

  <div class="fselect" data-filter="documentType" tabindex="0">
    <span class="fselect-label">Document Type</span>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
    <div class="fselect-dropdown">
      <div class="fselect-option" data-value="">All Types</div>
      <div class="fselect-option" data-value="Aadhaar Card">Aadhaar Card</div>
      <div class="fselect-option" data-value="Income Certificate">Income Certificate</div>
      <div class="fselect-option" data-value="Caste Certificate">Caste Certificate</div>
      <div class="fselect-option" data-value="Bonafide Certificate">Bonafide Certificate</div>
      <div class="fselect-option" data-value="Marksheet">Marksheet</div>
    </div>
  </div>

  <div class="fselect" data-filter="college" tabindex="0">
    <span class="fselect-label">College</span>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
    <div class="fselect-dropdown">
      <div class="fselect-option" data-value="">All Colleges</div>
      <% (colleges || []).forEach(function(c) { %>
        <div class="fselect-option" data-value="<%= c.College_Name %>"><%= c.College_Name %></div>
      <% }) %>
    </div>
  </div>

  <div class="results-count" id="results-count"><%= pagination.totalCount.toLocaleString('en-IN') %> pending verification</div>
</div>

<div class="grid-2 wide-right">
  <div class="panel">
    <table>
      <thead><tr><th>Student</th><th>Document</th><th>Status</th><th></th></tr></thead>
      <tbody id="verif-tbody">
        <% verifications.forEach(function(v) { %>
        <tr class="verif-row <%= selectedVerification && v.id === selectedVerification.id ? 'selected' : '' %>" data-id="<%= v.id %>">
          <td><div class="stu"><div class="mini-avatar"><%= v.initials %></div><div><div class="n"><%= v.studentName %></div><div class="m"><%= v.college %></div></div></div></td>
          <td><%= v.documentType %></td>
          <td><span class="pill <%= v.statusClass %>"><%= v.statusLabel %></span></td>
          <td><div class="row-icon">⋯</div></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <div class="pagination">
      <div class="info" id="pagination-info">Showing <%= pagination.from %>–<%= pagination.to %> of <%= pagination.totalCount.toLocaleString('en-IN') %></div>
      <div class="page-btns" id="page-btns">
        <div class="page-btn <%= pagination.currentPage === 1 ? 'disabled' : '' %>" data-page="prev">‹</div>
        <% for (let p = 1; p <= pagination.totalPages; p++) { %>
        <div class="page-btn <%= p === pagination.currentPage ? 'active' : '' %>" data-page="<%= p %>"><%= p %></div>
        <% } %>
        <div class="page-btn <%= pagination.currentPage === pagination.totalPages ? 'disabled' : '' %>" data-page="next">›</div>
      </div>
    </div>
  </div>

  <div class="panel panel-pad" id="verif-panel">
    <div class="subhead">Document Preview</div>
    <div style="border:1.5px dashed var(--line);border-radius:8px;height:200px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--ink-muted);gap:8px;margin-bottom:18px;background:var(--bg);">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M17 21H7a2 2 0 01-2-2V5a2 2 0 012-2h7l5 5v11a2 2 0 01-2 2z"/></svg>
      <span style="font-size:12px;" id="v-filename"><%= selectedVerification ? selectedVerification.fileName : 'No document selected' %></span>
    </div>
    <div class="subhead">Applicant</div>
    <div class="info-grid" id="v-info">
      <% if (selectedVerification) { %>
      <div class="info-item"><div class="k">Student</div><div class="v"><%= selectedVerification.studentName %></div></div>
      <div class="info-item"><div class="k">Student ID</div><div class="v"><%= selectedVerification.studentCode %></div></div>
      <div class="info-item"><div class="k">Document Type</div><div class="v"><%= selectedVerification.documentType %></div></div>
      <% } %>
    </div>
    <div class="divider"></div>
    <div class="subhead">Verification Checklist</div>
    <div class="doc-checklist" id="v-checklist">
      <% if (selectedVerification) { selectedVerification.checklist.forEach(function(c) { %>
      <div class="doc-check-row"><span class="l"><span class="check-icon <%= c.iconClass %>"><%= c.icon %></span><%= c.label %></span></div>
      <% }) } %>
    </div>
    <div class="detail-actions" style="padding:4px 0 0;">
      <button class="danger" id="reject-btn" data-id="<%= selectedVerification ? selectedVerification.id : '' %>" <%= selectedVerification ? '' : 'disabled' %>>Reject</button>
      <button class="primary" id="verify-btn" data-id="<%= selectedVerification ? selectedVerification.id : '' %>" <%= selectedVerification ? '' : 'disabled' %>>Verify</button>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const tbody = document.getElementById('verif-tbody');
  const panel = document.getElementById('verif-panel');
  const tabsRow = document.getElementById('tabs-row');
  const searchInput = document.getElementById('search-input');

  let currentTab = '<%= activeTab %>';
  let currentPage = <%= pagination.currentPage %>;
  const filterState = { documentType: '', college: '', search: '' };

  // ---- Tabs ----
  tabsRow.addEventListener('click', (e) => {
    const tab = e.target.closest('.tabx');
    if (!tab) return;
    tabsRow.querySelectorAll('.tabx').forEach(t => t.classList.remove('active'));
    tab.classList.add('active');
    currentTab = tab.dataset.tab;
    currentPage = 1;
    loadList();
  });

  // ---- Row click -> load detail ----
  tbody.addEventListener('click', (e) => {
    const row = e.target.closest('tr.verif-row');
    if (!row) return;
    loadDetail(row.dataset.id, row);
  });

  async function loadDetail(id, row) {
    document.querySelectorAll('tr.verif-row.selected').forEach(r => r.classList.remove('selected'));
    row.classList.add('selected');
    panel.classList.add('loading');

    try {
      const res = await fetch(`/eligibility/verification/${encodeURIComponent(id)}`);
      if (!res.ok) throw new Error(`Failed: ${res.status}`);
      const v = await res.json();
      renderDetail(v);
    } catch (err) {
      console.error(err);
      alert('Could not load document details. Please try again.');
    } finally {
      panel.classList.remove('loading');
    }
  }

  function renderDetail(v) {
    document.getElementById('v-filename').textContent = v.fileName;
    document.getElementById('v-info').innerHTML = `
      <div class="info-item"><div class="k">Student</div><div class="v">${v.studentName}</div></div>
      <div class="info-item"><div class="k">Student ID</div><div class="v">${v.studentCode}</div></div>
      <div class="info-item"><div class="k">Document Type</div><div class="v">${v.documentType}</div></div>
    `;
    document.getElementById('v-checklist').innerHTML = v.checklist.map(c => `
      <div class="doc-check-row"><span class="l"><span class="check-icon ${c.iconClass}">${c.icon}</span>${c.label}</span></div>
    `).join('');

    const verifyBtn = document.getElementById('verify-btn');
    const rejectBtn = document.getElementById('reject-btn');
    verifyBtn.dataset.id = v.id;
    rejectBtn.dataset.id = v.id;
    verifyBtn.disabled = false;
    rejectBtn.disabled = false;
  }

  // ---- Verify / Reject buttons ----
  document.getElementById('verify-btn').addEventListener('click', (e) => {
    updateStatus(e.target.dataset.id, 'Verified');
  });
  document.getElementById('reject-btn').addEventListener('click', (e) => {
    updateStatus(e.target.dataset.id, 'Rejected');
  });

  async function updateStatus(id, status) {
    if (!id) return;
    const verifyBtn = document.getElementById('verify-btn');
    const rejectBtn = document.getElementById('reject-btn');
    verifyBtn.disabled = true;
    rejectBtn.disabled = true;

    try {
      const res = await fetch(`/eligibility/verification/${encodeURIComponent(id)}/status`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status })
      });
      if (!res.ok) throw new Error(`Failed: ${res.status}`);

      await loadList();
    } catch (err) {
      console.error(err);
      alert('Could not update status. Please try again.');
    } finally {
      verifyBtn.disabled = false;
      rejectBtn.disabled = false;
    }
  }

  // ---- Filters ----
  const fselects = document.querySelectorAll('.fselect');
  fselects.forEach(fs => {
    const key = fs.dataset.filter;
    const label = fs.querySelector('.fselect-label');
    const defaultLabel = label.textContent;

    fs.addEventListener('click', () => {
      fselects.forEach(other => { if (other !== fs) other.classList.remove('open'); });
      fs.classList.toggle('open');
    });

    fs.querySelectorAll('.fselect-option').forEach(opt => {
      opt.addEventListener('click', (e) => {
        e.stopPropagation();
        const value = opt.dataset.value;
        filterState[key] = value;
        label.textContent = value ? opt.textContent : defaultLabel;
        fs.classList.toggle('active', !!value);
        fs.querySelectorAll('.fselect-option').forEach(o => o.classList.remove('selected'));
        opt.classList.add('selected');
        fs.classList.remove('open');
        currentPage = 1;
        loadList();
      });
    });
  });

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.fselect')) {
      fselects.forEach(fs => fs.classList.remove('open'));
    }
  });

  // ---- Search (debounced) ----
  let searchTimer;
  searchInput.addEventListener('input', (e) => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
      filterState.search = e.target.value.trim();
      currentPage = 1;
      loadList();
    }, 350);
  });

  // ---- Pagination ----
  document.getElementById('page-btns').addEventListener('click', (e) => {
    const btn = e.target.closest('.page-btn');
    if (!btn || btn.classList.contains('disabled')) return;

    if (btn.dataset.page === 'prev') currentPage = Math.max(1, currentPage - 1);
    else if (btn.dataset.page === 'next') currentPage += 1;
    else currentPage = parseInt(btn.dataset.page, 10);

    loadList();
  });

  // ---- Export ----
  document.getElementById('export-btn').addEventListener('click', () => {
    const params = new URLSearchParams({ tab: currentTab });
    Object.entries(filterState).forEach(([k, v]) => { if (v) params.set(k, v); });
    window.location.href = `/eligibility/export?${params.toString()}`;
  });

  // ---- Core list loader ----
  async function loadList() {
    const params = new URLSearchParams({ tab: currentTab, page: currentPage });
    Object.entries(filterState).forEach(([k, v]) => { if (v) params.set(k, v); });

    try {
      const res = await fetch(`/eligibility/list?${params.toString()}`);
      if (!res.ok) throw new Error(`Failed: ${res.status}`);
      const data = await res.json();
      renderList(data.verifications, data.pagination);
    } catch (err) {
      console.error(err);
      alert('Could not load the list. Please try again.');
    }
  }

  function renderList(verifications, pagination) {
    if (!verifications.length) {
      tbody.innerHTML = `<tr><td colspan="4" style="text-align:center;color:#999;padding:24px;">No records match these filters</td></tr>`;
    } else {
      tbody.innerHTML = verifications.map(v => `
        <tr class="verif-row" data-id="${v.id}">
          <td><div class="stu"><div class="mini-avatar">${v.initials}</div><div><div class="n">${v.studentName}</div><div class="m">${v.college}</div></div></div></td>
          <td>${v.documentType}</td>
          <td><span class="pill ${v.statusClass}">${v.statusLabel}</span></td>
          <td><div class="row-icon">⋯</div></td>
        </tr>
      `).join('');
    }

    document.getElementById('results-count').textContent =
      `${pagination.totalCount.toLocaleString('en-IN')} pending verification`;

    document.getElementById('pagination-info').textContent = pagination.totalCount
      ? `Showing ${pagination.from}–${pagination.to} of ${pagination.totalCount.toLocaleString('en-IN')}`
      : `Showing 0 of 0`;

    const pageBtns = document.getElementById('page-btns');
    let html = `<div class="page-btn ${pagination.currentPage === 1 ? 'disabled' : ''}" data-page="prev">‹</div>`;
    for (let p = 1; p <= pagination.totalPages; p++) {
      html += `<div class="page-btn ${p === pagination.currentPage ? 'active' : ''}" data-page="${p}">${p}</div>`;
    }
    html += `<div class="page-btn ${pagination.currentPage === pagination.totalPages ? 'disabled' : ''}" data-page="next">›</div>`;
    pageBtns.innerHTML = html;
  }
});
</script>

</main>
<%- include('partials/footer') %>
